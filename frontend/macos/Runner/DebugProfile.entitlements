<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- network.client: the app makes outbound HTTP/SSE to the sidecar over loopback (without it the
	     sandbox blocks every request → the app hangs on "connecting"). network.server: the spawned Go
	     sidecar (a child of this sandboxed app) listens on loopback. 客户端=app 出站 sidecar;服务端=子进程监听。 -->
	<!-- user-selected.read-only: the composer's attachment picker (file_selector) + pasted/dropped
	     files — the sandbox only grants what the user explicitly picked/dragged. 附件选择/粘贴/拖放的沙箱授权。 -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Sparkle's XPC services (Installer + Installer launcher) are looked up by these mach names;
	     the sandbox needs an explicit exception for each. Literal bundle id on purpose: the release
	     script re-signs with this file directly, where Xcode's $(PRODUCT_BUNDLE_IDENTIFIER) is not expanded.
	     Sparkle 的 XPC 服务按这两个 mach 名查找,沙箱须逐个放行。故意写死 bundle id:发行脚本直接拿本文件
	     重签,那里不会展开 Xcode 变量。 -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>website.anselm.app-spks</string>
		<string>website.anselm.app-spki</string>
	</array>
</dict>
</plist>
